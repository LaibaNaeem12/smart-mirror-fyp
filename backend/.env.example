# Copy to backend/.env and fill in values. Only backend/.env is loaded by the server.

PORT=5000

# MongoDB Atlas or local — must start with mongodb:// or mongodb+srv://
MONGO_URI=mongodb://127.0.0.1:27017/smart-mirror

# If MongoDB is configured but the server cannot connect, set to true to serve
# the embedded demo catalog instead of empty lists (default: false).
# USE_MOCK_CATALOG_WHEN_DB_UNAVAILABLE=false

# Optional: virtual try-on / ML worker (see backend/services/tryOnInferenceService.js)
# AI_TRYON_SERVICE_URL=http://127.0.0.1:8000
# AI_TRYON_SERVICE_TIMEOUT_MS=120000

# Replicate virtual try-on (server only — never expose in frontend; copy vars into backend/.env)
# https://replicate.com/account/api-tokens
# REPLICATE_API_TOKEN=
#
# Primary engine when REPLICATE_TRYON_MODEL is unset: "catvton" (default) or "idm-vton"
# REPLICATE_TRYON_PRIMARY=catvton
#
# Pin model + version (recommended). If you use owner/model only, REPLICATE_TRYON_VERSION is appended;
# otherwise a family-specific default digest is used (CATVTON vs IDM).
# CATVTON (needs Hugging Face token — FLUX.1-dev terms). If the token is missing, the server automatically
# falls back to pinned IDM-VTON for that request (no hard error).
# REPLICATE_TRYON_MODEL=mmezhov/catvton-flux:cc41d1b963023987ed2ddf26e9264efcc96ee076640115c303f95b0010f6a958
# REPLICATE_CATVTON_HF_TOKEN=hf_...
# Optional tuning: REPLICATE_CATVTON_WIDTH=576 REPLICATE_CATVTON_HEIGHT=768 REPLICATE_CATVTON_NUM_STEPS=32
#
# IDM-VTON (human_img + garm_img):
# REPLICATE_TRYON_MODEL=cuuupid/idm-vton:0513734a452173b8173e907e3a59d19a36266e55b48528559432bd21c7d7e985
# Or split:
# REPLICATE_TRYON_MODEL=cuuupid/idm-vton
# REPLICATE_TRYON_VERSION=0513734a452173b8173e907e3a59d19a36266e55b48528559432bd21c7d7e985
# REPLICATE_TRYON_HUMAN_FIELD=human_img
# REPLICATE_TRYON_GARMENT_FIELD=garm_img
# REPLICATE_TRYON_CATEGORY=upper_body
# REPLICATE_TRYON_TIMEOUT_MS=420000
# (Overall deadline for polling until success/failure.)
# REPLICATE_TRYON_POLL_INTERVAL_MS=2000
# (Legacy floor; async polling in generateTryOn now uses exponential 1s→10s.)
#
# GET /api/replicate/health-test — always on; runs replicate/hello-world probe + logs [TRYON HEALTH].
#
# Person images are resized server-side (sharp) before Replicate when possible (768×1024 max, JPEG q0.7).
#
# REPLICATE_TRYON_MAX_STARTING_MS=180000
# (If status stays "starting" longer than this, cancel — 0 disables and only timeoutMs applies.)
#
# Optional: log try-on pipeline (raw Replicate output summary, normalized URL, POST /api/tryon response shape).
# TRY_ON_FLOW_DEBUG=true
#
# Exhibition: if Replicate output is missing or equals the raw person/garment inputs, build a local Sharp
# overlay composite so the kiosk always returns a single try-on-like image. Set "false" to disable.
# TRY_ON_EXHIBITION_COMPOSITE_FALLBACK=true
#
# If prediction stays in Replicate status "starting" longer than this (ms), async GET /tryon/:id returns the
# exhibition composite immediately (0 disables). Default 15000.
# REPLICATE_TRYON_STARTING_ABORT_MS=15000
#
# Local MoveNet pose overlay (L2) before simple Sharp composite (L3). Set "false" to use L3 only (faster boot).
# TRY_ON_SMART_POSE_OVERLAY=true
# TRY_ON_POSE_MAX_SIDE=448
# TRY_ON_POSE_MIN_SCORE=0.22
# Optional: host MoveNet weights locally for offline kiosks (see TensorFlow.js pose-detection / TF Hub).
# MOVE_NET_MODEL_URL=
#
# Optional ComfyUI try-on (never executed unless ENABLE_COMFYUI=true — keeps code paths without a runtime dependency).
# ENABLE_COMFYUI=true
# COMFY_TRYON_BRIDGE_URL=http://127.0.0.1:8788/tryon
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# COMFYUI_TRYON_DIRECT=true
# COMFYUI_TRYON_WORKFLOW_FILE=C:/path/to/workflow.json
# COMFY_TRYON_TIMEOUT_MS=120000
#
# Debug only: enable GET /api/debug/replicate (tiny replicate/hello-world run; logs full JSON server-side).
# REPLICATE_DEBUG_ROUTE=true
# Optional override (owner/name:64-char-version). Default is pinned replicate/hello-world.
# REPLICATE_DEBUG_MODEL=replicate/hello-world:9dcd6d78e7c6560c340d916fe32e9f24aabfa331e5cce95fe31f77fb03121426

# Ollama (local LLM for POST /api/ai/stylist → { result: string })
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=120000
# If Ollama returns 500 / "unable to allocate CPU buffer", lower RAM use:
# OLLAMA_NUM_CTX=1024
# OLLAMA_NUM_BATCH=64
# OLLAMA_NUM_THREAD=4
# OLLAMA_NUM_GPU=0
# Or use a smaller model after `ollama pull phi3:mini` (or qwen2:0.5b):
# OLLAMA_MODEL=phi3:mini
# OLLAMA_DEBUG=true
