VITE_API_BASE_URL=http://127.0.0.1:5000

# Optional: browser console logs for try-on HTTP payload + result <img> hero src (restart Vite after change).
# VITE_TRY_ON_FLOW_DEBUG=true

# Exhibition / kiosk demo: AI presence UX + offline-style fallback (no scary error UI). Default in code is true if unset.
# VITE_EXHIBITION_MODE=true

# Optional: ms in Replicate starting/processing before exhibition fallback illusion (default 60000).
# VITE_TRYON_FALLBACK_MS=60000
